        </mxCell>
        <mxCell id="v1131" value="Filter each reward separately; renormalize retained n" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=18;fontColor=#697780;fontStyle=0;align=left;verticalAlign=middle;spacing=0;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="835.0000" y="1289.0000" width="550.0000" height="27.0000" as="geometry" />
        </mxCell>
        <mxCell id="v1132" value="A = (r − question mean) / (question sample std + 10⁻⁶); sample std uses correction = 1." style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;fontColor=#27323A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;rotation=0;" vertex="1" parent="1">
          <mxGeometry x="105.0000" y="1373.0000" width="1230.0000" height="29.0000" as="geometry" />
        </mxCell>
        <mxCell id="v1133" value="Soft rewards use historical frozen-probe reconstruction; raw scalar normalization, not PPO clipping." style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=18;fontColor=#697780;fontStyle=0;align=left;verticalAlign=middle;spacing=0;rotation=0;" vertex="1" parent="1">
