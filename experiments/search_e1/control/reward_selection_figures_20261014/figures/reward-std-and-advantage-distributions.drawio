        <mxCell id="v1130" value="Hard: 108 groups / n = 540   ·   Soft: 258 groups / n = 1,290" style="text;html=0;whiteSpace=wrap;overflow=visible;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;fontColor=#27323A;fontStyle=0;align=left;verticalAlign=middle;spacing=0;rotation=0;" vertex="1" parent="1">
